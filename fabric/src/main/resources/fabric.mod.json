{
  "schemaVersion": 1,
  "id": "paperarc",
  "version": "${version}",
  "name": "PaperArc",
  "description": "Paper API compatibility layer for Arclight. Implements the paper plugin API surface without Paper's optimizations.",
  "authors": [
    "PaperArc Contributors"
  ],
  "license": "MIT",
  "environment": "*",
  "accessWidener": "paperarc.accesswidener",
  "entrypoints": {
    "main": [
      "com.ixnah.mc.paperarc.fabric.PaperArcFabric"
    ]
  },
  "mixins": [
    "paperarc-common.mixins.json",
    "paperarc-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21"
  }
}
